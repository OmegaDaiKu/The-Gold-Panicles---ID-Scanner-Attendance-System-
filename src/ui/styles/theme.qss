/* ==========================================================================
   THE GOLD PANICLES — QR ATTENDANCE SYSTEM
   Minimal Editorial Publication Theme
   ========================================================================== */

/* Main Containers & Dialog Windows */
QMainWindow,
QDialog,
QWidget#mainContainer {
    background-color: #FBFBFE;
    color: #040316;
    font-family: "M Ying Hei PRC W5", "M Ying Hei PRC", "Helvetica Neue", "Helvetica", Arial, sans-serif;
    font-size: 13px;
}

QWidget {
    outline: none;
}

QWidget:focus {
    border: 1.5px solid #0C0F18;
}

QMenuBar:focus,
QStatusBar:focus {
    border: none;
}

/* Header Masthead */
QFrame#mainHeaderFrame {
    background-color: #ECE3DA;
    border-bottom: 1px solid #DDD5CE;
}

/* Primary Container Cards & Panels */
QFrame#surfaceCard,
QFrame#headerCard,
QWidget#cardPanel,
QFrame#cardSuper,
QFrame#cardSurface,
QFrame#verificationCard,
QGroupBox {
    background-color: #ECE3DA;
    border: 1px solid #DDD5CE;
    border-radius: 6px;
    color: #040316;
}

/* Summary / Metric Cards */
QFrame#statCard {
    background-color: #ECE3DA;
    border: 1px solid #DDD5CE;
    border-radius: 6px;
}

/* Typography Hierarchy */
QLabel {
    color: #040316;
    font-family: "M Ying Hei PRC W5", "M Ying Hei PRC", "Helvetica Neue", "Helvetica", Arial, sans-serif;
    font-size: 13px;
    background: transparent;
}

QLabel#brandHeader {
    color: #0C0F18;
    font-family: "M Ying Hei PRC W5", "M Ying Hei PRC", "Helvetica Neue", "Helvetica", sans-serif;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.8px;
}

QLabel#textSecondary,
QLabel#subText {
    color: #504C5A;
    font-family: "Helvetica Neue", "Helvetica", Arial, sans-serif;
    font-size: 11px;
}

QLabel#textMuted {
    color: #6B6775;
    font-family: "Helvetica Neue", "Helvetica", Arial, sans-serif;
    font-size: 11px;
}

QLabel#liveClockLabel {
    color: #040316;
    font-size: 11px;
    font-weight: 600;
    font-family: "Consolas", "JetBrains Mono", "Courier New", monospace;
    padding: 5px 12px;
    background-color: #EEE6E2;
    border: 1px solid #DDD5CE;
    border-radius: 4px;
}

QLabel#adminUserBadge {
    color: #0C0F18;
    background-color: #EEE6E2;
    border: 1px solid #DDD5CE;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
    padding: 5px 10px;
    font-family: "Consolas", "JetBrains Mono", monospace;
}

QLabel#statCardTitle {
    color: #6B6775;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    font-family: "Helvetica Neue", "Helvetica", Arial, sans-serif;
}

QLabel#statCardValue {
    color: #040316;
    font-size: 28px;
    font-weight: 800;
    font-family: "Consolas", "JetBrains Mono", monospace;
}

QLabel#sectionTitle {
    color: #0C0F18;
    font-family: "M Ying Hei PRC W5", "M Ying Hei PRC", "Helvetica Neue", "Helvetica", sans-serif;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.3px;
}

QLabel#sectionTitleDanger {
    color: #A51D24;
    font-family: "M Ying Hei PRC W5", "M Ying Hei PRC", "Helvetica Neue", "Helvetica", sans-serif;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.3px;
}

QLabel#headingSection {
    color: #0C0F18;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.5px;
}

QLabel#formLabel {
    color: #504C5A;
    font-family: "Helvetica Neue", "Helvetica", Arial, sans-serif;
    font-size: 11px;
    font-weight: 600;
}

QLabel#formErrorLabel {
    color: #A51D24;
    font-family: "Helvetica Neue", "Helvetica", Arial, sans-serif;
    font-size: 11px;
    font-weight: 600;
}

QLabel#dialogSubjectName {
    color: #040316;
    font-family: "M Ying Hei PRC W5", "M Ying Hei PRC", "Helvetica Neue", "Helvetica", sans-serif;
    font-size: 16px;
    font-weight: 800;
}

QLabel#dialogEmphasisText {
    color: #0C0F18;
    font-weight: 700;
}

QLabel#dialogHeaderInfo {
    background-color: #E8F0FE;
    color: #1A56DB;
    border: 1px solid #B8D5F8;
    border-radius: 4px;
    padding: 8px 12px;
    font-weight: 600;
}

QLabel#dialogHeaderDanger {
    background-color: #FCE8E6;
    color: #A51D24;
    border: 1px solid #F5C2C7;
    border-radius: 4px;
    padding: 8px 12px;
    font-weight: 600;
}

QLabel#infoChipGold {
    background-color: #ECE3DA;
    color: #0C0F18;
    border: 1px solid #DDD5CE;
    border-radius: 4px;
    padding: 3px 10px;
    font-weight: 700;
    font-size: 10px;
}

/* Form Controls & Inputs */
QLineEdit,
QComboBox,
QSpinBox,
QDateEdit,
QTextEdit {
    background-color: #FBFBFE;
    color: #040316;
    font-family: "Consolas", "JetBrains Mono", monospace;
    border: 1px solid #DDD5CE;
    border-radius: 4px;
    padding: 8px 12px;
    min-height: 20px;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDateEdit:focus,
QTextEdit:focus {
    border: 1.5px solid #0C0F18;
    background-color: #FFFFFF;
}

QLineEdit#gpSuperInput {
    background-color: #FFFFFF;
    color: #040316;
    font-family: "Consolas", "JetBrains Mono", monospace;
    font-size: 13px;
    font-weight: 500;
    border: 1px solid #DDD5CE;
    border-radius: 4px;
    padding: 10px 14px;
}

QLineEdit#gpSuperInput:focus {
    border: 1.5px solid #0C0F18;
}

QLineEdit#searchInput {
    background-color: #FFFFFF;
    color: #040316;
    border: 1px solid #DDD5CE;
    border-radius: 4px;
    padding: 6px 10px;
}

QLineEdit#searchInput:focus {
    border: 1.5px solid #0C0F18;
}

/* Push Buttons */
QPushButton {
    background-color: #EEE6E2;
    color: #040316;
    font-family: "Helvetica Neue", "Helvetica", Arial, sans-serif;
    border: 1px solid #DDD5CE;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    padding: 6px 14px;
}

QPushButton:hover {
    background-color: #ECE3DA;
    border-color: #0C0F18;
}

QPushButton:disabled {
    color: #A09BAE;
    border-color: #E2DBD4;
    background-color: #F4EFEB;
}

/* Primary Action Buttons */
QPushButton#btn_primary,
QPushButton#primaryButton {
    background-color: #0C0F18;
    color: #FBFBFE;
    border: 1px solid #0C0F18;
    border-radius: 4px;
    font-weight: 700;
    padding: 6px 16px;
}

QPushButton#btn_primary:hover,
QPushButton#primaryButton:hover {
    background-color: #242A38;
    border-color: #242A38;
}

QPushButton#btn_cancel {
    background-color: #EEE6E2;
    color: #504C5A;
    border: 1px solid #DDD5CE;
    border-radius: 4px;
}

QPushButton#btn_cancel:hover {
    background-color: #ECE3DA;
    color: #040316;
    border-color: #C8BFB7;
}

/* Solid Danger Action Button */
QPushButton#btn_danger_solid {
    background-color: #C5221F;
    color: #FFFFFF;
    border: 1px solid #C5221F;
    border-radius: 4px;
    font-weight: 700;
}

QPushButton#btn_danger_solid:hover {
    background-color: #A51D24;
    border-color: #A51D24;
}

/* Row Action Buttons in Tables */
QPushButton#btn_row_edit {
    background-color: #E8F0FE;
    color: #1A56DB;
    border: 1px solid #B8D5F8;
    border-radius: 4px;
}

QPushButton#btn_row_edit:hover {
    background-color: #D2E3FC;
}

QPushButton#btn_row_delete {
    background-color: #FCE8E6;
    color: #A51D24;
    border: 1px solid #F5C2C7;
    border-radius: 4px;
}

QPushButton#btn_row_delete:hover {
    background-color: #FAD2CF;
}

QPushButton#btn_row_warning {
    background-color: #FEF7E0;
    color: #8F5800;
    border: 1px solid #FCE293;
    border-radius: 4px;
}

QPushButton#btn_row_warning:hover {
    background-color: #FEEFC3;
}

QPushButton#btn_row_success {
    background-color: #E6F4EA;
    color: #0F6D38;
    border: 1px solid #B7E1CD;
    border-radius: 4px;
}

QPushButton#btn_row_success:hover {
    background-color: #CEEAD6;
}

QPushButton#btn_tonal {
    background-color: #ECE3DA;
    color: #040316;
    border: 1px solid #DDD5CE;
    border-radius: 4px;
    font-weight: 700;
}

QPushButton#btn_tonal:hover {
    background-color: #EEE6E2;
    border-color: #0C0F18;
}

QPushButton#filterPill {
    background-color: #EEE6E2;
    color: #504C5A;
    border: 1px solid #DDD5CE;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 600;
    padding: 4px 12px;
}

QPushButton#filterPill:hover {
    background-color: #ECE3DA;
    color: #040316;
}

QPushButton#filterPill:checked {
    background-color: #0C0F18;
    color: #FBFBFE;
    border-color: #0C0F18;
    font-weight: 700;
}

QPushButton#btn_chrome {
    background-color: #EEE6E2;
    color: #040316;
    border: 1px solid #DDD5CE;
    border-radius: 4px;
}

QPushButton#btn_chrome:hover {
    border-color: #0C0F18;
    background-color: #ECE3DA;
}

QPushButton#btn_chrome_danger {
    background-color: #FCE8E6;
    color: #A51D24;
    border: 1px solid #F5C2C7;
    border-radius: 4px;
}

QPushButton#btn_chrome_danger:hover {
    background-color: #FAD2CF;
}

/* Tab Navigation Container (Admin Dashboard) */
QTabWidget::pane {
    border: 1px solid #DDD5CE;
    background-color: #FBFBFE;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #EEE6E2;
    color: #504C5A;
    font-family: "Helvetica Neue", "Helvetica", Arial, sans-serif;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 18px;
    border: 1px solid #DDD5CE;
    border-bottom: none;
    margin-right: 3px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: #FBFBFE;
    color: #0C0F18;
    font-weight: 700;
    border-top: 2.5px solid #0C0F18;
}

QTabBar::tab:hover:!selected {
    background-color: #ECE3DA;
    color: #040316;
}

/* Data Table Styling */
QTableWidget,
QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F8F5F2;
    color: #040316;
    border: 1px solid #DDD5CE;
    border-radius: 4px;
    gridline-color: #ECE3DA;
    font-size: 11px;
    selection-background-color: #ECE3DA;
    selection-color: #040316;
}

QHeaderView::section {
    background-color: #EEE6E2;
    color: #0C0F18;
    font-family: "Helvetica Neue", "Helvetica", Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #0C0F18;
}

/* Status Badges */
QLabel#badge_overdue {
    background-color: #FCE8E6;
    color: #A51D24;
    border: 1px solid #F5C2C7;
    border-radius: 3px;
    padding: 2px 8px;
    font-weight: 700;
    font-size: 10px;
}

QLabel#badge_completed {
    background-color: #E8F0FE;
    color: #1A56DB;
    border: 1px solid #B8D5F8;
    border-radius: 3px;
    padding: 2px 8px;
    font-weight: 700;
    font-size: 10px;
}

QLabel#badge_active {
    background-color: #E6F4EA;
    color: #0F6D38;
    border: 1px solid #B7E1CD;
    border-radius: 3px;
    padding: 2px 8px;
    font-weight: 700;
    font-size: 10px;
}

QLabel#badge_inactive {
    background-color: #EEE6E2;
    color: #6B6775;
    border: 1px solid #DDD5CE;
    border-radius: 3px;
    padding: 2px 8px;
    font-weight: 700;
    font-size: 10px;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #FBFBFE;
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #DDD5CE;
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: #0C0F18;
}

QScrollBar:horizontal {
    background-color: #FBFBFE;
    height: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #DDD5CE;
    min-width: 24px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #0C0F18;
}

/* Calendar Widget */
QCalendarWidget QWidget {
    background-color: #FBFBFE;
    color: #040316;
}

#qt_calendar_navigationbar {
    background-color: #ECE3DA;
    border-bottom: 1px solid #DDD5CE;
}

QCalendarWidget QAbstractItemView {
    selection-background-color: #0C0F18;
    selection-color: #FBFBFE;
}

/* Status Bar */
QStatusBar#mainStatusBar {
    background-color: #ECE3DA;
    border-top: 1px solid #DDD5CE;
    color: #504C5A;
    font-size: 10px;
    font-family: "Consolas", monospace;
    padding: 2px 10px;
}

/* Camera Count Frame */
QFrame#cameraCountFrame {
    background-color: #EEE6E2;
    border: 1px solid #DDD5CE;
    border-radius: 4px;
}

QLabel#cameraStatusLabel {
    color: #504C5A;
    font-family: "Consolas", monospace;
    font-size: 10px;
    font-weight: 700;
}
