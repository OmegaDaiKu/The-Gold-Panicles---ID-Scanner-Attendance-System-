/* ==========================================================================
   THE GOLD PANICLES — QR ATTENDANCE SYSTEM
   Desktop Kiosk Terminal v2.4 (HTML Parity Build)
   ========================================================================== */

QMainWindow,
QDialog,
QWidget#mainContainer {
    /* FLAGGED, NOT CHANGED: this value (#050507) disagrees both with
       theme.py's Colors.CANVAS (#0B0B0C) AND with this same file's own
       QScrollBar:vertical background-color (#0B0B0C) below -- i.e. this
       file is internally inconsistent about its own canvas color, not just
       out of sync with theme.py. Awaiting confirmation on which value is
       canonical before changing either location. */
    background-color: #050507;
    color: #F4EFEA;
    font-family: "Helvetica Neue", "Segoe UI", -apple-system, BlinkMacSystemFont, "Roboto", sans-serif;
    font-size: 13px;
}

QWidget {
    outline: none;
}

QWidget:focus {
    border: 2px solid #DAA520;
}

QMenuBar:focus,
QStatusBar:focus {
    border: none;
}

/* OS Window Title Header Bar */
QFrame#mainHeaderFrame {
    background-color: #08080A;
    border-bottom: 1px solid #1C1C20;
}

/* Primary Container Cards — Asymmetric Super Graphic Motif */
QFrame#surfaceCard,
QFrame#headerCard,
QWidget#cardPanel,
QFrame#cardSuper,
QFrame#cardSurface,
QFrame#verificationCard,
QGroupBox {
    background-color: #141416;
    border: 1px solid #24242A;
    border-top-left-radius: 24px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    color: #F4EFEA;
}

/* ADDED THIS SESSION: QFrame has no generic base rule in this stylesheet,
   so QFrame#statCard (overview.py's StatCard, used on the admin dashboard's
   landing tab) previously rendered with zero background/border/radius at
   all -- a confirmed, zero-fallback visual bug, not merely a missing
   polish item. Uses a smaller corner radius than the main surface cards
   (20px vs 24px) since stat cards are a smaller, denser grid element. */
QFrame#statCard {
    background-color: #141416;
    border: 1px solid #24242A;
    border-top-left-radius: 20px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

/* Typography */
QLabel {
    color: #F4EFEA;
    font-family: "Helvetica Neue", "Segoe UI", -apple-system, BlinkMacSystemFont, "Roboto", sans-serif;
    font-size: 13px;
    background: transparent;
}

QLabel#brandHeader {
    color: #DAA520;
    font-family: "Helvetica Neue", "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.6px;
}

QLabel#textSecondary,
QLabel#subText {
    color: #8E8E93;
    font-size: 11px;
}

QLabel#textMuted {
    color: #8E8E93;
    font-size: 11px;
}

QLabel#liveClockLabel {
    color: #F4EFEA;
    font-size: 11px;
    font-weight: 600;
    font-family: "Consolas", "JetBrains Mono", "Courier New", monospace;
    padding: 4px 12px;
    background-color: #08080A;
    border: 1px solid #24242A;
    border-top-left-radius: 8px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

/* ADDED THIS SESSION: stat card title/value had no QSS rule at all. Falls
   back to the generic QLabel rule above (plain #F4EFEA body text) rather
   than crashing, but with no visual hierarchy between a card's label and
   its big headline number. */
QLabel#statCardTitle {
    color: #8E8E93;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.4px;
}

QLabel#statCardValue {
    color: #F4EFEA;
    font-size: 28px;
    font-weight: 800;
    font-family: "Consolas", "JetBrains Mono", monospace;
}

/* ADDED THIS SESSION: section titles had no dedicated rule; fell back to
   generic QLabel body-text styling with no emphasis at all. */
QLabel#sectionTitle {
    color: #F4EFEA;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.4px;
}

QLabel#sectionTitleDanger {
    color: #FF99A4;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.4px;
}

QLabel#headingSection {
    color: #DAA520;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

/* ADDED THIS SESSION: FORM_ERROR_LABEL previously had no styling, meaning
   a validation error message would render as plain white body text --
   indistinguishable from a normal label. This was the clearest
   semantically-meaningful gap in this whole missing-selector batch. */
QLabel#formLabel {
    color: #A1A1AA;
    font-size: 11px;
    font-weight: 600;
}

QLabel#formErrorLabel {
    color: #FF99A4;
    font-size: 11px;
    font-weight: 600;
}

/* ADDED THIS SESSION: dialog text/chip roles had no styling. */
QLabel#dialogSubjectName {
    color: #F4EFEA;
    font-size: 16px;
    font-weight: 800;
}

QLabel#dialogEmphasisText {
    color: #DAA520;
    font-weight: 700;
}

QLabel#dialogHeaderInfo {
    background-color: #122B3D;
    color: #80C8FF;
    border: 1px solid #1C3D54;
    border-radius: 6px;
    padding: 8px 12px;
    font-weight: 600;
}

QLabel#dialogHeaderDanger {
    background-color: #58111A;
    color: #FF99A4;
    border: 1px solid #7A1B28;
    border-radius: 6px;
    padding: 8px 12px;
    font-weight: 600;
}

QLabel#infoChipGold {
    background-color: #2E2512;
    color: #E5B842;
    border: 1px solid rgba(218, 165, 32, 0.35);
    border-radius: 10px;
    padding: 3px 10px;
    font-weight: 700;
    font-size: 10px;
}

/* Form Controls & Inputs */
QLineEdit,
QComboBox,
QSpinBox,
QDateEdit,
QTextEdit {
    background-color: #08080A;
    color: #F4EFEA;
    font-family: "Consolas", "JetBrains Mono", monospace;
    border: 1px solid #24242A;
    border-top-left-radius: 8px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    padding: 8px 12px;
    min-height: 20px;
}

QLineEdit:focus,
QComboBox:focus {
    border: 1px solid #DAA520;
    background-color: #08080A;
}

QLineEdit#gpSuperInput {
    background-color: #08080A;
    color: #F4EFEA;
    font-size: 13px;
    font-weight: 500;
    border: 1px solid #24242A;
    border-top-left-radius: 12px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    padding: 10px 14px;
}
QLineEdit#gpSuperInput:focus {
    border: 1px solid #DAA520;
}

QLineEdit#searchInput {
    background-color: #08080A;
    border: 1px solid #24242A;
    border-radius: 4px;
    padding: 6px 10px;
}

/* Push Buttons */
QPushButton {
    background-color: #1C1C20;
    color: #F4EFEA;
    font-family: "Helvetica Neue", "Segoe UI", sans-serif;
    border: 1px solid #24242A;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    padding: 6px 14px;
}
QPushButton:hover {
    background-color: #24242A;
    border-color: #3A3A44;
}

QPushButton#btn_primary,
QPushButton#primaryButton {
    background-color: #DAA520;
    color: #000000;
    border: none;
    border-top-left-radius: 8px;
    font-weight: 700;
}
QPushButton#btn_primary:hover,
QPushButton#primaryButton:hover {
    background-color: #E5B842;
}

/* ADDED THIS SESSION: previously fell back to the generic QPushButton rule
   above -- not broken, but not role-differentiated (a Cancel button looked
   identical to every other neutral button). */
QPushButton#btn_cancel {
    background-color: #1C1C20;
    color: #A1A1AA;
    border: 1px solid #24242A;
    border-top-left-radius: 8px;
}
QPushButton#btn_cancel:hover {
    background-color: #24242A;
    color: #F4EFEA;
}

QPushButton#btn_danger_solid {
    background-color: #C62828;
    color: #FFFFFF;
    border: none;
    border-top-left-radius: 8px;
    font-weight: 700;
}
QPushButton#btn_danger_solid:hover {
    background-color: #E53935;
}

/* ADDED THIS SESSION: row-action buttons (presumed used by staff_mgmt.py /
   overdue_resolution.py table rows -- not directly re-verified against
   those files' exact usage this turn) previously had no color
   differentiation from a plain neutral button. */
QPushButton#btn_row_edit {
    background-color: #1C1C20;
    color: #80C8FF;
    border: 1px solid #1C3D54;
    border-top-left-radius: 8px;
}
QPushButton#btn_row_edit:hover {
    background-color: #122B3D;
}

QPushButton#btn_row_delete {
    background-color: #1C1C20;
    color: #FF99A4;
    border: 1px solid #58111A;
    border-top-left-radius: 8px;
}
QPushButton#btn_row_delete:hover {
    background-color: #2A1014;
}

QPushButton#btn_row_warning {
    background-color: #1C1C20;
    color: #D9B872;
    border: 1px solid #4E3E1A;
    border-top-left-radius: 8px;
}
QPushButton#btn_row_warning:hover {
    background-color: #3A2E12;
}

QPushButton#btn_row_success {
    background-color: #1C1C20;
    color: #8FE3B0;
    border: 1px solid #1E5A38;
    border-top-left-radius: 8px;
}
QPushButton#btn_row_success:hover {
    background-color: #113B24;
}

QPushButton#btn_tonal {
    background-color: #1C1C20;
    color: #E5B842;
    border: 1px solid #24242A;
    font-weight: 700;
}
QPushButton#btn_tonal:hover {
    background-color: #24242A;
    border-color: #DAA520;
}

QPushButton#filterPill {
    background-color: #1C1C20;
    color: #CBD5E1;
    border: none;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 600;
    padding: 4px 12px;
}
QPushButton#filterPill:hover {
    background-color: #24242A;
}
QPushButton#filterPill:checked {
    background-color: #DAA520;
    color: #000000;
    border-top-left-radius: 6px;
    font-weight: 700;
}

QPushButton#btn_chrome {
    background-color: #1C1C20;
    color: #F4EFEA;
    border: 1px solid #24242A;
    border-top-left-radius: 8px;
}
QPushButton#btn_chrome:hover {
    border-color: #DAA520;
}

QPushButton#btn_chrome_danger {
    background-color: #2A1014;
    color: #FDA4AF;
    border: 1px solid #58111A;
    border-top-left-radius: 8px;
}
QPushButton#btn_chrome_danger:hover {
    background-color: #3D141A;
}

/* High-Density Data Log Stream Table */
QTableWidget,
QTableView {
    background-color: #070709;
    alternate-background-color: #0E0E12;
    color: #F4EFEA;
    border: 1px solid #24242A;
    border-radius: 4px;
    gridline-color: #16161A;
    font-size: 11px;
}

QHeaderView::section {
    background-color: #141418;
    color: #DAA520;
    font-family: "Consolas", "JetBrains Mono", monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 8px;
    border: none;
    border-bottom: 1px solid rgba(218, 165, 32, 0.6);
}

/* Status Badges
   NOTE: these two rules (badge_overdue / badge_completed) have no matching
   ObjectNames constant in theme.py, unlike every other styled element in
   this file. Flagged as likely-dead CSS, superseded by the custom-painted
   PillWidget used on the live attendance board (which reads Colors
   directly in Python and never touches QSS). Left in place rather than
   removed, per standing dead-code convention -- only their drifted border
   hex values were corrected to match theme.py's Colors exactly below. */
QLabel#badge_overdue {
    background-color: #58111A;
    color: #FF99A4;
    border: 1px solid #7A1B28;
    border-top-left-radius: 8px;
    border-bottom-right-radius: 2px;
    padding: 2px 8px;
    font-weight: 700;
    font-size: 10px;
}

QLabel#badge_completed {
    background-color: #122B3D;
    color: #80C8FF;
    border: 1px solid #1C3D54;
    border-top-left-radius: 8px;
    border-bottom-right-radius: 2px;
    padding: 2px 8px;
    font-weight: 700;
    font-size: 10px;
}

/* ADDED THIS SESSION: unlike badge_overdue/completed above, BADGE_ACTIVE
   and BADGE_INACTIVE DO have real ObjectNames constants predating this
   session's audit-driven additions, strongly suggesting genuine usage
   (most likely staff_mgmt.py's active/inactive status display) -- yet had
   no styling at all. Colored using the same green/neutral hues introduced
   this session for the new STATUS_OPEN semantic, for visual consistency. */
QLabel#badge_active {
    background-color: #113B24;
    color: #8FE3B0;
    border: 1px solid #1E5A38;
    border-top-left-radius: 8px;
    border-bottom-right-radius: 2px;
    padding: 2px 8px;
    font-weight: 700;
    font-size: 10px;
}

QLabel#badge_inactive {
    background-color: #1B1B1F;
    color: #8E8E93;
    border: 1px solid #24242A;
    border-top-left-radius: 8px;
    border-bottom-right-radius: 2px;
    padding: 2px 8px;
    font-weight: 700;
    font-size: 10px;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #0B0B0C;
    width: 4px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background-color: #24242A;
    min-height: 20px;
    border-radius: 2px;
}
QScrollBar::handle:vertical:hover {
    background-color: #DAA520;
}

/* Calendar Widget */
QCalendarWidget QWidget {
    background-color: #070709;
    color: #F4EFEA;
}
#qt_calendar_navigationbar {
    background-color: #141416;
}
QCalendarWidget QAbstractItemView {
    selection-background-color: #DAA520;
    selection-color: #000000;
}

QStatusBar#mainStatusBar {
    background-color: #08080A;
    border-top: 1px solid #1C1C20;
    color: #8E8E93;
    font-size: 10px;
    font-family: "Consolas", monospace;
    padding: 2px 10px;
}