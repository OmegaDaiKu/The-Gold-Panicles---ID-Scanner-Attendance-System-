/* ==========================================================================
   THE GOLD PANICLES — QR ATTENDANCE SYSTEM
   Apple-level Premium Warm Dark & Gold Publication Theme (Obsidian Carbon / Leaf Gold)
   
   Every color, border, and spatial value strictly mirrors Phase 1 Design Tokens in theme.py.
   ========================================================================== */

/* --------------------------------------------------------------------------
   Root Window & Container Foundations
   -------------------------------------------------------------------------- */
QMainWindow,
QDialog,
QWidget#mainContainer,
QWidget#stationViewContainer,
QWidget#adminDashboardContainer {
    background-color: #0D0C12;
    color: #F7F5FA;
    font-family: "M Ying Hei PRC W5", "M Ying Hei PRC", "Inter", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QWidget {
    outline: none;
}

QMenuBar:focus,
QStatusBar:focus,
QToolBar:focus {
    border: none;
}

/* Header Masthead Frame */
QFrame#mainHeaderFrame {
    background-color: #161522;
    border-bottom: 1px solid #2A273C;
}

/* --------------------------------------------------------------------------
   Surface Cards & Elevated Containers (Apple HIG 12px Radius)
   -------------------------------------------------------------------------- */
QFrame#surfaceCard,
QFrame#headerCard,
QWidget#cardPanel,
QFrame#cardSuper,
QFrame#cardSurface,
QFrame#verificationCard,
QFrame#stationCard,
QFrame#metricsCard,
QFrame#calendarCard,
QFrame#modalCardContainer,
QGroupBox {
    background-color: #161522;
    border: 1px solid #2A273C;
    border-radius: 12px;
    color: #F7F5FA;
    padding: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #E2B842;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
}

/* Metric / Stat Summary Cards */
QFrame#statCard {
    background-color: #161522;
    border: 1px solid #2A273C;
    border-radius: 12px;
    padding: 16px;
}

QFrame#statCard:hover {
    border-color: #3D3856;
    background-color: #1E1C2E;
}

/* --------------------------------------------------------------------------
   Typography Hierarchy (WCAG 2.1 AA Compliant)
   -------------------------------------------------------------------------- */
QLabel {
    color: #F7F5FA;
    font-family: "M Ying Hei PRC W5", "M Ying Hei PRC", "Inter", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
    background: transparent;
    border: none;
}

QLabel#brandHeader {
    color: #F7F5FA;
    font-family: "M Ying Hei PRC W5", "M Ying Hei PRC", "Inter", sans-serif;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.8px;
}

QLabel#textSecondary,
QLabel#subText {
    color: #C8C4D6;
    font-family: "Inter", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 11px;
}

QLabel#textMuted,
QLabel#emptyStateLabel {
    color: #9D97B0;
    font-family: "Inter", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 11px;
}

QLabel#liveClockLabel {
    color: #F7F5FA;
    font-size: 11px;
    font-weight: 600;
    font-family: "JetBrains Mono", "Consolas", monospace;
    padding: 6px 12px;
    background-color: #1E1C2E;
    border: 1px solid #2A273C;
    border-radius: 8px;
}

QLabel#adminUserBadge {
    color: #E2B842;
    background-color: #1E1C2E;
    border: 1px solid #2A273C;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
    padding: 6px 12px;
    font-family: "JetBrains Mono", "Consolas", monospace;
}

QLabel#statCardTitle {
    color: #9D97B0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    font-family: "Inter", "Segoe UI", sans-serif;
}

QLabel#statCardValue {
    color: #F7F5FA;
    font-size: 28px;
    font-weight: 800;
    font-family: "JetBrains Mono", "Consolas", monospace;
}

QLabel#sectionTitle {
    color: #F7F5FA;
    font-family: "M Ying Hei PRC W5", "M Ying Hei PRC", "Inter", sans-serif;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.3px;
}

QLabel#sectionTitleDanger {
    color: #F43F5E;
    font-family: "M Ying Hei PRC W5", "M Ying Hei PRC", "Inter", sans-serif;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.3px;
}

QLabel#headingSection {
    color: #F7F5FA;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.5px;
}

QLabel#formLabel {
    color: #C8C4D6;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 11px;
    font-weight: 600;
}

QLabel#formErrorLabel {
    color: #F43F5E;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 11px;
    font-weight: 600;
}

QLabel#dialogSubjectName {
    color: #F7F5FA;
    font-family: "M Ying Hei PRC W5", "M Ying Hei PRC", "Inter", sans-serif;
    font-size: 16px;
    font-weight: 800;
}

QLabel#dialogEmphasisText {
    color: #F7F5FA;
    font-weight: 700;
}

QLabel#dialogHeaderInfo {
    background-color: rgba(226, 184, 66, 0.12);
    color: #E2B842;
    border: 1px solid rgba(226, 184, 66, 0.28);
    border-radius: 8px;
    padding: 8px 12px;
    font-weight: 600;
}

QLabel#dialogHeaderDanger {
    background-color: rgba(244, 63, 94, 0.12);
    color: #F43F5E;
    border: 1px solid rgba(244, 63, 94, 0.28);
    border-radius: 8px;
    padding: 8px 12px;
    font-weight: 600;
}

QLabel#infoChipGold {
    background-color: rgba(226, 184, 66, 0.12);
    color: #E2B842;
    border: 1px solid rgba(226, 184, 66, 0.28);
    border-radius: 6px;
    padding: 3px 10px;
    font-weight: 700;
    font-size: 10px;
}

/* --------------------------------------------------------------------------
   Form Controls & Input Fields (Apple HIG 8px Radius & Focus Glow)
   -------------------------------------------------------------------------- */
QLineEdit,
QComboBox,
QSpinBox,
QDateEdit,
QTimeEdit,
QTextEdit {
    background-color: #161522;
    color: #F7F5FA;
    font-family: "JetBrains Mono", "Consolas", monospace;
    border: 1px solid #2A273C;
    border-radius: 8px;
    padding: 8px 12px;
    min-height: 22px;
    selection-background-color: #C49C2F;
    selection-color: #0D0C12;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QTextEdit:focus {
    border: 1.5px solid #E2B842;
    background-color: #1E1C2E;
}

QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDateEdit:disabled,
QTextEdit:disabled {
    background-color: #0D0C12;
    color: #9D97B0;
    border-color: #1E1C2E;
}

QLineEdit#gpSuperInput {
    background-color: #161522;
    color: #F7F5FA;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid #2A273C;
    border-radius: 8px;
    padding: 10px 14px;
}

QLineEdit#gpSuperInput:focus {
    border: 1.5px solid #E2B842;
    background-color: #1E1C2E;
}

QLineEdit#searchInput {
    background-color: #161522;
    color: #F7F5FA;
    border: 1px solid #2A273C;
    border-radius: 8px;
    padding: 6px 12px;
    font-family: "Inter", "Segoe UI", sans-serif;
}

QLineEdit#searchInput:focus {
    border: 1.5px solid #E2B842;
    background-color: #1E1C2E;
}

/* QComboBox Dropdown Menu Styling */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left-width: 0px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox QAbstractItemView {
    background-color: #161522;
    color: #F7F5FA;
    border: 1px solid #2A273C;
    border-radius: 8px;
    selection-background-color: #1E1C2E;
    selection-color: #E2B842;
    outline: none;
    padding: 4px;
}

/* --------------------------------------------------------------------------
   Push Buttons & Interactive Actions
   -------------------------------------------------------------------------- */
QPushButton {
    background-color: #1E1C2E;
    color: #F7F5FA;
    font-family: "Inter", "Segoe UI", Arial, sans-serif;
    border: 1px solid #2A273C;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 600;
    padding: 7px 16px;
}

QPushButton:focus {
    border-color: #E2B842;
}

QPushButton:hover {
    background-color: #252238;
    border-color: #E2B842;
}

QPushButton:pressed {
    background-color: #161522;
    border-color: #C49C2F;
}

QPushButton:disabled {
    color: #9D97B0;
    border-color: #1E1C2E;
    background-color: #161522;
}

/* Primary Action Buttons — Solid Metallic Gold */
QPushButton#btn_primary,
QPushButton#primaryButton {
    background-color: #E2B842;
    color: #0D0C12;
    border: 1px solid #E2B842;
    border-radius: 8px;
    font-weight: 700;
    padding: 7px 18px;
}

QPushButton#btn_primary:hover,
QPushButton#primaryButton:hover {
    background-color: #EFCA53;
    border-color: #EFCA53;
}

QPushButton#btn_primary:pressed,
QPushButton#primaryButton:pressed {
    background-color: #C49C2F;
    border-color: #C49C2F;
}

/* Cancel / Secondary Neutral Buttons */
QPushButton#btn_cancel {
    background-color: #1E1C2E;
    color: #C8C4D6;
    border: 1px solid #2A273C;
    border-radius: 8px;
}

QPushButton#btn_cancel:hover {
    background-color: #252238;
    color: #F7F5FA;
    border-color: #3D3856;
}

/* Solid Danger Action Buttons */
QPushButton#btn_danger_solid {
    background-color: #F43F5E;
    color: #FFFFFF;
    border: 1px solid #F43F5E;
    border-radius: 8px;
    font-weight: 700;
}

QPushButton#btn_danger_solid:hover {
    background-color: #FB7185;
    border-color: #FB7185;
}

QPushButton#btn_danger_solid:pressed {
    background-color: #E11D48;
    border-color: #E11D48;
}

/* Table Row Action Buttons */
QPushButton#btn_row_edit {
    background-color: rgba(226, 184, 66, 0.12);
    color: #E2B842;
    border: 1px solid rgba(226, 184, 66, 0.28);
    border-radius: 6px;
    padding: 3px 8px;
}

QPushButton#btn_row_edit:hover {
    background-color: rgba(226, 184, 66, 0.22);
    border-color: #E2B842;
}

QPushButton#btn_row_delete {
    background-color: rgba(244, 63, 94, 0.12);
    color: #F43F5E;
    border: 1px solid rgba(244, 63, 94, 0.28);
    border-radius: 6px;
    padding: 3px 8px;
}

QPushButton#btn_row_delete:hover {
    background-color: rgba(244, 63, 94, 0.22);
    border-color: #F43F5E;
}

QPushButton#btn_row_warning {
    background-color: rgba(245, 158, 11, 0.12);
    color: #F59E0B;
    border: 1px solid rgba(245, 158, 11, 0.28);
    border-radius: 6px;
    padding: 3px 8px;
}

QPushButton#btn_row_warning:hover {
    background-color: rgba(245, 158, 11, 0.22);
    border-color: #F59E0B;
}

QPushButton#btn_row_success {
    background-color: rgba(16, 185, 129, 0.12);
    color: #10B981;
    border: 1px solid rgba(16, 185, 129, 0.28);
    border-radius: 6px;
    padding: 3px 8px;
}

QPushButton#btn_row_success:hover {
    background-color: rgba(16, 185, 129, 0.22);
    border-color: #10B981;
}

QPushButton#btn_tonal {
    background-color: #1E1C2E;
    color: #F7F5FA;
    border: 1px solid #2A273C;
    border-radius: 8px;
    font-weight: 700;
}

QPushButton#btn_tonal:hover {
    background-color: #252238;
    border-color: #E2B842;
}

/* Filter Pills (Apple-style Refined Tonal State) */
QPushButton#filterPill {
    background-color: #161522;
    color: #C8C4D6;
    border: 1px solid #2A273C;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 600;
    padding: 4px 14px;
}

QPushButton#filterPill:hover {
    background-color: #1E1C2E;
    color: #F7F5FA;
    border-color: #3D3856;
}

QPushButton#filterPill:checked {
    background-color: rgba(226, 184, 66, 0.16);
    color: #E2B842;
    border: 1px solid rgba(226, 184, 66, 0.38);
    font-weight: 700;
}

QPushButton#btn_chrome {
    background-color: #1E1C2E;
    color: #F7F5FA;
    border: 1px solid #2A273C;
    border-radius: 8px;
}

QPushButton#btn_chrome:hover {
    border-color: #E2B842;
    background-color: #252238;
}

QPushButton#btn_chrome_danger {
    background-color: rgba(244, 63, 94, 0.12);
    color: #F43F5E;
    border: 1px solid rgba(244, 63, 94, 0.28);
    border-radius: 8px;
}

QPushButton#btn_chrome_danger:hover {
    background-color: rgba(244, 63, 94, 0.22);
    border-color: #F43F5E;
}

/* --------------------------------------------------------------------------
   Tab Navigation & Admin Shell Views
   -------------------------------------------------------------------------- */
QTabWidget::pane {
    border: 1px solid #2A273C;
    background-color: #0D0C12;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: #161522;
    color: #C8C4D6;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 11px;
    font-weight: 600;
    padding: 8px 18px;
    border: 1px solid #2A273C;
    border-bottom: none;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected {
    background-color: #1E1C2E;
    color: #F7F5FA;
    font-weight: 700;
    border-top: 2px solid #E2B842;
}

QTabBar::tab:hover:!selected {
    background-color: #1A1826;
    color: #F7F5FA;
}

/* --------------------------------------------------------------------------
   Data Table Styling (Clean Muted Headers & Soft Selection)
   -------------------------------------------------------------------------- */
QTableWidget,
QTableView {
    background-color: #161522;
    alternate-background-color: #1A1826;
    color: #F7F5FA;
    border: 1px solid #2A273C;
    border-radius: 12px;
    gridline-color: transparent;
    font-size: 11px;
    selection-background-color: #1E1C2E;
    selection-color: #F7F5FA;
}

QHeaderView::section {
    background-color: #161522;
    color: #9D97B0;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #2A273C;
    text-transform: uppercase;
}

QTableCornerButton::section {
    background-color: #161522;
    border: none;
}

/* --------------------------------------------------------------------------
   Status & Badge Indicators (Translucent Soft Chips)
   -------------------------------------------------------------------------- */
QLabel#badge_overdue {
    background-color: rgba(244, 63, 94, 0.12);
    color: #F43F5E;
    border: 1px solid rgba(244, 63, 94, 0.28);
    border-radius: 6px;
    padding: 3px 10px;
    font-weight: 700;
    font-size: 10px;
}

QLabel#badge_completed {
    background-color: rgba(226, 184, 66, 0.12);
    color: #E2B842;
    border: 1px solid rgba(226, 184, 66, 0.28);
    border-radius: 6px;
    padding: 3px 10px;
    font-weight: 700;
    font-size: 10px;
}

QLabel#badge_active,
QLabel#badge_open {
    background-color: rgba(16, 185, 129, 0.12);
    color: #10B981;
    border: 1px solid rgba(16, 185, 129, 0.28);
    border-radius: 6px;
    padding: 3px 10px;
    font-weight: 700;
    font-size: 10px;
}

QLabel#badge_resolved {
    background-color: rgba(245, 158, 11, 0.12);
    color: #F59E0B;
    border: 1px solid rgba(245, 158, 11, 0.28);
    border-radius: 6px;
    padding: 3px 10px;
    font-weight: 700;
    font-size: 10px;
}

QLabel#badge_inactive {
    background-color: #1E1C2E;
    color: #9D97B0;
    border: 1px solid #2A273C;
    border-radius: 6px;
    padding: 3px 10px;
    font-weight: 700;
    font-size: 10px;
}

/* --------------------------------------------------------------------------
   Scrollbar Components (Subtle Track & Soft Handle)
   -------------------------------------------------------------------------- */
QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #2A273C;
    min-height: 28px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: #3D3856;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 6px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #2A273C;
    min-width: 28px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #3D3856;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --------------------------------------------------------------------------
   Calendar Widget
   -------------------------------------------------------------------------- */
QCalendarWidget QWidget {
    background-color: #0D0C12;
    color: #F7F5FA;
}

#qt_calendar_navigationbar {
    background-color: #161522;
    border-bottom: 1px solid #2A273C;
}

QCalendarWidget QAbstractItemView {
    selection-background-color: #E2B842;
    selection-color: #0D0C12;
    background-color: #161522;
    gridline-color: #2A273C;
}

/* --------------------------------------------------------------------------
   Status Bar & Tooltips
   -------------------------------------------------------------------------- */
QStatusBar#mainStatusBar {
    background-color: #161522;
    border-top: 1px solid #2A273C;
    color: #C8C4D6;
    font-size: 10px;
    font-family: "JetBrains Mono", monospace;
    padding: 3px 12px;
}

QToolTip {
    background-color: #1E1C2E;
    color: #F7F5FA;
    border: 1px solid #2A273C;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 11px;
}

/* --------------------------------------------------------------------------
   Camera / Viewport Framework
   -------------------------------------------------------------------------- */
QFrame#cameraCountFrame {
    background-color: #161522;
    border: 1px solid #2A273C;
    border-radius: 8px;
}

QLabel#cameraStatusLabel {
    color: #C8C4D6;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 700;
}